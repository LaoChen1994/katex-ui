{
  "name": "katex-ui",
  "version": "1.0.1",
  "description": "Formula calculator engine that turns expressions and pragmatic LaTeX into serializable schemas.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "formula",
    "calculator",
    "dynamic-form",
    "latex",
    "expression",
    "schema",
    "typescript",
    "low-code"
  ],
  "homepage": "https://laochen1994.github.io/katex-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaoChen1994/katex-ui.git",
    "directory": "packages/katex-ui"
  },
  "bugs": {
    "url": "https://github.com/LaoChen1994/katex-ui/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expr-eval": "^2.0.2"
  },
  "devDependencies": {}
}
