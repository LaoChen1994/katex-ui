{
  "name": "katex-ui-vue",
  "version": "1.0.1",
  "description": "Vue 3 live formula form renderer for katex-ui calculator schemas.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "formula",
    "calculator",
    "dynamic-form",
    "latex",
    "vue",
    "schema",
    "typescript",
    "low-code"
  ],
  "homepage": "https://laochen1994.github.io/katex-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaoChen1994/katex-ui.git",
    "directory": "packages/katex-ui-vue"
  },
  "bugs": {
    "url": "https://github.com/LaoChen1994/katex-ui/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "katex-ui": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "happy-dom": "^20.9.0",
    "vite": "^6.0.7",
    "vue": "^3.5.35",
    "vue-tsc": "^2.2.12"
  }
}
